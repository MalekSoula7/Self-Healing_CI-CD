# PipeHeal environment. Copy to `.env` in the repo root and fill in. Never commit `.env`.
# Values here are local-dev defaults or empty placeholders, never real secrets.
# Each app validates only the variables it uses (fail fast on startup); the phase that
# first needs a variable is noted above it.

# ---------------------------------------------------------------- runtime (Phase 0)
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- local infrastructure (Phase 0)
# Host ports used by `docker compose` (change if 5432/6379 are taken on your machine).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Must match the ports above.
DATABASE_URL=postgresql://pipeheal:pipeheal@localhost:5432/pipeheal
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- apps/web (Phase 0)
# Public base URL of the web app (OAuth callback, links in PR bodies).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- apps/worker gateway (Phase 0)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000

# ---------------------------------------------------------------- auth: Better Auth (Phase 1)
# 32+ random bytes, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- GitHub App (Phase 1, CHECKPOINT 1a)
# From the App's settings page. See docs/SETUP-GITHUB-APP.md (P1.5).
GITHUB_APP_ID=
# App slug; the bot login is "<slug>[bot]" (OIDC actor check, SPEC §5.4).
GITHUB_APP_SLUG=
# PEM private key with newlines written as \n (exact format decided in P1.4).
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The App's OAuth client credentials, used for user sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# https://smee.io/<channel> for forwarding webhooks to your machine in development.
SMEE_URL=

# ---------------------------------------------------------------- Anthropic (Phase 2 triage, Phase 4 healing)
# Key from the dedicated dev workspace with a spend limit (SPEC §7.5). Tests never use it.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5-20251001
HEAL_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- agent gateway, public side (Phase 4)
# URL the heal-action reaches from GitHub runners.
GATEWAY_PUBLIC_URL=
OIDC_AUDIENCE=pipeheal

# ---------------------------------------------------------------- observability (Phase 8)
SENTRY_DSN=
