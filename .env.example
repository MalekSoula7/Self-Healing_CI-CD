# PipeHeal environment. Copy to `.env` in the repo root and fill in. Never commit `.env`.
# Values here are local-dev defaults or empty placeholders, never real secrets.
# Each app validates only the variables it uses (fail fast on startup); the phase that
# first needs a variable is noted above it.

# ---------------------------------------------------------------- runtime (Phase 0)
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- local infrastructure (Phase 0)
# Host ports used by `docker compose` (change if 5432/6379 are taken on your machine).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Must match the ports above.
DATABASE_URL=postgresql://pipeheal:pipeheal@localhost:5432/pipeheal
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- apps/web (Phase 0)
# Public base URL of the web app (OAuth callback, links in PR bodies).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- apps/worker gateway (Phase 0)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
# Internal listener for /readyz (reports dependency states). Keep it off the public network.
GATEWAY_INTERNAL_HOST=127.0.0.1
GATEWAY_INTERNAL_PORT=4001
# Comma-separated IPs or CIDRs of reverse proxies in front of the gateway whose X-Forwarded-For is
# believed for rate limiting. Leave empty without a proxy: anything else lets clients pick their IP.
GATEWAY_TRUSTED_PROXIES=

# ---------------------------------------------------------------- auth: Better Auth (Phase 1)
# GitHub sign-in needs BETTER_AUTH_SECRET, GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET (below).
# In development, leave all three empty to run without sign-in; production requires them.
# Signs cookies and encrypts stored GitHub tokens: changing it signs everyone out.
# 32+ random bytes, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------- GitHub App (Phase 1, CHECKPOINT 1a)
# From the App's settings page. See docs/SETUP-GITHUB-APP.md (P1.5).
GITHUB_APP_ID=
# App slug; the bot login is "<slug>[bot]" (OIDC actor check, SPEC §5.4).
GITHUB_APP_SLUG=
# The App's private key: the downloaded .pem file, base64-encoded on one line. PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("pipeheal-dev.private-key.pem"))
GITHUB_APP_PRIVATE_KEY=
# 32+ random characters, also entered in the App's settings (same command as BETTER_AUTH_SECRET).
GITHUB_WEBHOOK_SECRET=
# The App's OAuth client credentials, used for user sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# https://smee.io/<channel> for forwarding webhooks to your machine in development.
SMEE_URL=

# ---------------------------------------------------------------- models: self-hosted Ollama (D11)
# Phase 2 triage, Phase 4 healing. In production Ollama runs on the application's own host
# (http://localhost:11434); in development it may be another machine on your LAN, e.g.
# http://192.168.1.20:11434. Never expose Ollama's port to the internet. Tests never call it.
OLLAMA_URL=http://localhost:11434
# Ollama model tags, pulled on that server (`ollama pull qwen3:14b`). One 14B model fits a
# 12 GB GPU; using the same model for both avoids swapping between them.
TRIAGE_MODEL=qwen3:14b
HEAL_MODEL=qwen3:14b
# The dispatcher (P4.8) starts healer runs on watched repositories by itself. Off unless "true":
# until D20 (the healer job's GitHub environment) is decided, turn it on for sandbox repos only.
HEAL_DISPATCH=false

# ---------------------------------------------------------------- agent gateway, public side (Phase 4)
# URL the heal-action reaches from GitHub runners.
GATEWAY_PUBLIC_URL=
OIDC_AUDIENCE=pipeheal

# ---------------------------------------------------------------- observability (Phase 8)
SENTRY_DSN=
