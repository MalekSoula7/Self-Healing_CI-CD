{
  "name": "pipeheal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:webhooks": "tsx --env-file-if-exists=.env scripts/dev-webhooks.ts",
    "break": "tsx scripts/break.ts",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:e2e": "pnpm --filter @pipeheal/web test:e2e",
    "db:generate": "pnpm --filter @pipeheal/db generate",
    "db:migrate": "pnpm --filter @pipeheal/db migrate",
    "db:seed": "pnpm --filter @pipeheal/db seed",
    "db:studio": "pnpm --filter @pipeheal/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@pipeheal/db": "workspace:*",
    "@pipeheal/shared": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
